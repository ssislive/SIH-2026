# ===========================
# KRISHISETU - .gitignore
# ===========================

# -------- Dependencies --------
node_modules/
.pnp
.pnp.js

# -------- Environment Variables --------
# NEVER commit .env files — contains secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# -------- Build Output --------
dist/
build/
*.tsbuildinfo

# -------- Logs --------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------- OS Files --------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# -------- IDE / Editor --------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# -------- Frontend (when added later) --------
# krishisetu-frontend/ build artifacts
krishisetu-frontend/dist/
krishisetu-frontend/build/
krishisetu-frontend/node_modules/
krishisetu-frontend/.vite/

# -------- Testing --------
coverage/
.nyc_output/
*.lcov

# -------- Temporary / Misc --------
tmp/
temp/
.cache/
*.pid
*.seed
*.pid.lock

# -------- Turbo / Monorepo --------
.turbo/

# -------- Package Managers --------
.yarn-integrity
.pnpm-store/

# -------- PWA / Service Worker (dev generated) --------
# Don't ignore sw.js if manually maintained
# public/sw.js.map if generated

# -------- Freebuff --------
.freebuff/

# -------- Generated docs --------
BACKEND_PLAN.txt
SETUP_COMMANDS.txt
TEST_COMMANDS.txt
FRONTEND_PLAN.txt
